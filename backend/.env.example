PORT=3000
NODE_ENV=development

# Database (sql.js / SQLite)
DB_CLIENT=sqlite3
DB_FILENAME=./data/hub.sqlite

# For PostgreSQL later:
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hub
# DB_USER=postgres
# DB_PASSWORD=postgres

# VAPID keys for Web Push — generate with: npm run generate-vapid
VAPID_SUBJECT=mailto:admin@hub.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=1048576

# Base URL (for generating absolute URLs in notifications)
BASE_URL=http://localhost:3000

# Admin panel auth (single admin account). Generate a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# If ADMIN_PASSWORD is empty in dev, a random one is generated and printed on startup.

# JWT secret for admin sessions — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# CORS: comma-separated allowed origins. Empty/omitted = allow all (dev only).
# CORS_ORIGINS=https://hub.example.com,https://admin.example.com
